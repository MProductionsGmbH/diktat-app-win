<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral logic: settings, text cleanup, history. Runs and is tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Diktat.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Diktat.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- English texts, keyed by the German text in the code. -->
    <EmbeddedResource Include="Localization\en.json" LogicalName="Diktat.Core.Localization.en.json" />
    <Using Include="Diktat.Core.Localization" />
  </ItemGroup>
</Project>
