<Window x:Class="Diktat.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Diktat.Windows.Views"
        Title="Diktat"
        Width="1060" Height="760" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/Diktat.ico"
        FontFamily="{DynamicResource Diktat.Font}" FontSize="13.5"
        Foreground="{DynamicResource Diktat.Text}"
        Background="{DynamicResource Diktat.Sidebar}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar (Mica shows through on Windows 11) -->
        <Grid x:Name="Sidebar" Margin="12,14,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="8,0,0,20">
                <Image Source="pack://application:,,,/Assets/icon-64.png" Width="30" Height="30"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Diktat"/>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Diktat" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="by MProductions" FontSize="11.5" Foreground="{DynamicResource Diktat.TextSecondary}"/>
                </StackPanel>
            </StackPanel>

            <ListBox x:Name="Nav" Grid.Row="1" Style="{DynamicResource Diktat.SidebarList}" SelectionChanged="OnNavChanged"
                     AutomationProperties.Name="Bereiche">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type v:NavItem}">
                        <Grid AutomationProperties.Name="{Binding Title}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource Diktat.IconFont}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"/>
                            <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{DynamicResource Diktat.Recording}" VerticalAlignment="Center"
                                     Visibility="{Binding HasBadge, Converter={StaticResource Diktat.BoolToVisibility}}"
                                     ToolTip="Läuft gerade"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="3" CornerRadius="10" Padding="12" Background="{DynamicResource Diktat.SuccessSoft}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource Diktat.IconText}" Text="&#xE72E;" FontSize="12" Margin="0,0,6,0"
                                   Foreground="{DynamicResource Diktat.SuccessText}"/>
                        <TextBlock Text="Alles auf diesem PC" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Diktat.SuccessText}"/>
                    </StackPanel>
                    <TextBlock Text="Kein Konto, keine Telemetrie. Audio wird nach dem Diktat gelöscht." Margin="0,4,0,0"
                               Style="{DynamicResource Diktat.CaptionText}" FontSize="12"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="VersionText" Grid.Row="4" Margin="10,10,0,0" FontSize="11.5" Foreground="{DynamicResource Diktat.TextTertiary}"/>
        </Grid>

        <!-- Page -->
        <Border Grid.Column="1" Background="{DynamicResource Diktat.Page}" CornerRadius="10,0,0,0"
                BorderBrush="{DynamicResource Diktat.CardEdge}" BorderThickness="1,1,0,0">
            <ContentControl x:Name="PageHost" Focusable="False"/>
        </Border>
    </Grid>
</Window>
