<Window x:Class="Diktat.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Diktat.Windows.Views"
        xmlns:v="clr-namespace:Diktat.Windows.Views"
        Title="Diktat"
        Width="1060" Height="760" MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/Diktat.ico"
        FontFamily="{DynamicResource Diktat.Font}" FontSize="13.5"
        Foreground="{DynamicResource Diktat.Text}"
        Background="{DynamicResource Diktat.Sidebar}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        AllowDrop="True" PreviewDragEnter="OnWindowDragOver" PreviewDragOver="OnWindowDragOver"
        PreviewDragLeave="OnWindowDragLeave" PreviewDrop="OnWindowDrop">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar (Mica shows through on Windows 11) -->
        <Grid x:Name="Sidebar" Margin="12,14,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="8,0,0,20">
                <Image Source="pack://application:,,,/Assets/icon-64.png" Width="30" Height="30"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Diktat"/>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Diktat" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="{l:T 'by MProductions'}" FontSize="11.5" Foreground="{DynamicResource Diktat.TextSecondary}"/>
                </StackPanel>
            </StackPanel>

            <ListBox x:Name="Nav" Grid.Row="1" Style="{DynamicResource Diktat.SidebarList}" SelectionChanged="OnNavChanged"
                     AutomationProperties.Name="{l:T 'Bereiche'}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type v:NavItem}">
                        <Grid AutomationProperties.Name="{Binding Title}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{DynamicResource Diktat.IconFont}" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"/>
                            <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{DynamicResource Diktat.Recording}" VerticalAlignment="Center"
                                     Visibility="{Binding HasBadge, Converter={StaticResource Diktat.BoolToVisibility}}"
                                     ToolTip="{l:T 'Läuft gerade'}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- What stays on this PC; UpdatePrivacyBadge says it when the AI modes send text elsewhere. -->
            <Border x:Name="PrivacyBadge" Grid.Row="3" CornerRadius="10" Padding="12" Background="{DynamicResource Diktat.SuccessSoft}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PrivacyIcon" Style="{DynamicResource Diktat.IconText}" Text="&#59182;" FontSize="12" Margin="0,0,6,0"
                                   Foreground="{DynamicResource Diktat.SuccessText}"/>
                        <TextBlock x:Name="PrivacyTitle" Text="{l:T 'Alles auf diesem PC'}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Diktat.SuccessText}"/>
                    </StackPanel>
                    <TextBlock x:Name="PrivacyText" Text="{l:T 'Kein Konto, keine Telemetrie. Audio wird nach dem Diktat gelöscht.'}" Margin="0,4,0,0"
                               Style="{DynamicResource Diktat.CaptionText}" FontSize="12"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="VersionText" Grid.Row="4" Margin="10,10,0,0" FontSize="11.5" Foreground="{DynamicResource Diktat.TextTertiary}"/>
        </Grid>

        <!-- Page -->
        <!-- An audio file dropped on any page goes to "Audiodatei"; that page shows its own drop zone. -->
        <Border Grid.Column="1" Background="{DynamicResource Diktat.Page}" CornerRadius="10,0,0,0"
                BorderBrush="{DynamicResource Diktat.CardEdge}" BorderThickness="1,1,0,0">
            <Grid>
                <ContentControl x:Name="PageHost" Focusable="False"/>
                <Grid x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" Margin="12">
                    <Rectangle RadiusX="16" RadiusY="16" StrokeThickness="2" StrokeDashArray="4 3"
                               Stroke="{DynamicResource Diktat.Accent}" Fill="{DynamicResource Diktat.AccentSoft}"/>
                    <TextBlock Text="{l:T 'Loslassen zum Transkribieren'}" Style="{DynamicResource Diktat.HeadingText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
