<Window x:Class="Diktat.Windows.Views.TrayPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Diktat.Windows.Views.Controls"
        xmlns:v="clr-namespace:Diktat.Windows.Views"
        Title="Diktat"
        Width="404" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        FontFamily="{DynamicResource Diktat.Font}" FontSize="13.5"
        Foreground="{DynamicResource Diktat.Text}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        AutomationProperties.Name="Diktat">
    <!-- The margin leaves room for the shadow; the visible panel is the border inside. -->
    <Border x:Name="Panel" Margin="12" CornerRadius="12" Background="{DynamicResource Diktat.Page}"
            BorderBrush="{DynamicResource Diktat.Stroke}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: brand, meeting, settings -->
            <Grid Margin="16,14,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/Assets/icon-64.png" Width="28" Height="28" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Diktat"/>
                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Diktat" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="by MProductions" FontSize="11" Foreground="{DynamicResource Diktat.TextSecondary}"/>
                </StackPanel>
                <Button Grid.Column="2" Click="OnMeeting" Padding="10,6" Margin="0,0,4,0"
                        ToolTip="Ein Meeting aufnehmen: Transkript mit Personen und auf Wunsch Zusammenfassung">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource Diktat.IconText}" Text="&#xE716;" FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="Meeting"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{DynamicResource Diktat.IconButton}" Content="&#xE713;" Click="OnSettings"
                        ToolTip="Einstellungen" AutomationProperties.Name="Einstellungen"/>
            </Grid>

            <ScrollViewer Grid.Row="1" x:Name="Scroller" MaxHeight="560" Style="{DynamicResource Diktat.PageScroller}">
                <v:Stack Spacing="12" Margin="16,0,16,14">

                    <!-- Update available -->
                    <Border Style="{DynamicResource Diktat.Notice}" Visibility="{Binding HasUpdate, Converter={StaticResource Diktat.BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{DynamicResource Diktat.IconText}" Text="&#xE896;" Foreground="{DynamicResource Diktat.Accent}" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UpdateTitle}" FontWeight="SemiBold"/>
                                <TextBlock Text="Neue Version auf GitHub." Style="{DynamicResource Diktat.CaptionText}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Laden" Style="{DynamicResource Diktat.PrimaryButton}" Padding="12,5" Click="OnUpdate"/>
                        </Grid>
                    </Border>

                    <!-- Setup needed -->
                    <Border Style="{DynamicResource Diktat.CardStyle}" Visibility="{Binding NeedsSetup, Converter={StaticResource Diktat.BoolToVisibility}}">
                        <v:Stack Spacing="8">
                            <TextBlock Text="Einrichtung nötig" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Style="{DynamicResource Diktat.CaptionText}"
                                       Text="Der Assistent führt durch Mikrofon, Sprachmodell und Kurzbefehl. Diktat transkribiert direkt auf diesem PC."/>
                            <Button Content="Einrichtung starten" Style="{DynamicResource Diktat.PrimaryButton}" HorizontalAlignment="Left" Click="OnSetup"/>
                        </v:Stack>
                    </Border>

                    <!-- A meeting is running -->
                    <Border Style="{DynamicResource Diktat.ErrorNotice}" Visibility="{Binding ShowsMeetingBanner, Converter={StaticResource Diktat.BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource Diktat.Recording}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding MeetingBannerTitle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="Öffnen" Padding="12,5" Click="OnMeeting"/>
                        </Grid>
                    </Border>

                    <!-- Dictation card: start button, status, levels -->
                    <Border Style="{DynamicResource Diktat.CardStyle}">
                        <v:Stack Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="MicButton" Width="52" Height="52" Click="OnMicClick" Style="{DynamicResource Diktat.MicButton}"
                                        ToolTip="{Binding MicToolTip}" AutomationProperties.Name="{Binding MicToolTip}">
                                    <TextBlock x:Name="MicGlyph" Style="{DynamicResource Diktat.IconText}" Text="&#xE720;" FontSize="20"
                                               Foreground="{DynamicResource Diktat.OnPrimary}"/>
                                </Button>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusTitle}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding StatusDetail}" Style="{DynamicResource Diktat.CaptionText}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Recording: levels and buttons -->
                            <Grid Visibility="{Binding IsRecording, Converter={StaticResource Diktat.BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <c:LevelBars Height="28" BarCount="28" Level="{Binding AudioLevel}" IsActive="{Binding IsRecording}" Margin="0,0,10,0"/>
                                <Button Grid.Column="1" Content="Fertig" Style="{DynamicResource Diktat.PrimaryButton}" Padding="12,5" Margin="0,0,6,0"
                                        Click="OnStop" ToolTip="Aufnahme beenden und Text einfügen"/>
                                <Button Grid.Column="2" Content="Abbrechen" Padding="12,5" Click="OnCancel" ToolTip="Aufnahme verwerfen"/>
                            </Grid>

                            <ProgressBar IsIndeterminate="True" Visibility="{Binding IsProcessing, Converter={StaticResource Diktat.BoolToVisibility}}"
                                         AutomationProperties.Name="Wird verarbeitet"/>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{DynamicResource Diktat.IconText}" Text="&#xE72E;" FontSize="11" Margin="0,0,6,0"
                                           Foreground="{DynamicResource Diktat.SuccessText}"/>
                                <TextBlock Text="{Binding PrivacyLine}" Style="{DynamicResource Diktat.CaptionText}" FontSize="12" MaxWidth="300"/>
                            </StackPanel>
                        </v:Stack>
                    </Border>

                    <!-- After an AI mode: what was said word for word -->
                    <Border Style="{DynamicResource Diktat.Notice}" Visibility="{Binding ShowsInsertTranscript, Converter={StaticResource Diktat.BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding InsertTranscriptTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="Ersetzt den eben eingefügten Text durch dein wörtliches Diktat." Style="{DynamicResource Diktat.CaptionText}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Ersetzen" Padding="12,5" Margin="10,0,0,0" Click="OnInsertTranscript"/>
                        </Grid>
                    </Border>

                    <!-- Open the main window -->
                    <Button Click="OnOpenWindow" Padding="14,0" Height="46" HorizontalContentAlignment="Stretch"
                            BorderBrush="{DynamicResource Diktat.Accent}" BorderThickness="1.5"
                            ToolTip="Öffnet das Fenster mit Verlauf, Modi, Meetings und Einstellungen">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{DynamicResource Diktat.IconText}" Text="&#xE8A7;" Foreground="{DynamicResource Diktat.Accent}" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="Diktat öffnen" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Verlauf, Modi, Einstellungen" FontSize="12" FontWeight="Normal"
                                       Foreground="{DynamicResource Diktat.TextSecondary}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Modes -->
                    <StackPanel>
                        <TextBlock Text="Modi" Style="{DynamicResource Diktat.SectionHeaderText}" Margin="2,0,0,8"/>
                        <Border Style="{DynamicResource Diktat.CardStyle}" Padding="4">
                            <ItemsControl ItemsSource="{Binding Modes}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{DynamicResource Diktat.RowButton}" Command="{Binding StartCommand}"
                                                IsEnabled="{Binding IsAvailable}" ToolTip="{Binding ToolTip}" ToolTipService.ShowOnDisabled="True"
                                                AutomationProperties.Name="{Binding AutomationName}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <c:ModeIcon x:Name="Icon" Mode="{Binding Mode}" Size="34"/>
                                                <StackPanel x:Name="Texts" Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Diktat.TextSecondary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <c:HotkeyBadge x:Name="Keys" Grid.Column="2" Label="{Binding Hotkey}"/>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter TargetName="Icon" Property="Opacity" Value="0.45"/>
                                                <Setter TargetName="Texts" Property="Opacity" Value="0.6"/>
                                                <Setter TargetName="Keys" Property="Opacity" Value="0.4"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- The last text as a sent message; a click copies it -->
                    <StackPanel Visibility="{Binding HasLastText, Converter={StaticResource Diktat.BoolToVisibility}}" Margin="40,0,0,0"
                                HorizontalAlignment="Right">
                        <Button Click="OnCopyLast" Style="{DynamicResource Diktat.RowButton}" Padding="0" HorizontalAlignment="Right"
                                ToolTip="Kopieren" AutomationProperties.Name="{Binding LastText, StringFormat='Letzter Text: {0}. Klicken zum Kopieren'}">
                            <Border CornerRadius="16,16,4,16" Background="{DynamicResource Diktat.Mode.DaySoft}" Padding="14,10">
                                <TextBlock Text="{Binding LastText}" TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis" FontSize="13"/>
                            </Border>
                        </Button>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,6,0">
                            <TextBlock FontSize="11" Margin="0,0,5,0" Foreground="{DynamicResource Diktat.TextSecondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Diktat.IconText}">
                                        <Setter Property="Text" Value="&#xE8C8;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastCopied}" Value="True">
                                                <Setter Property="Text" Value="&#xE73E;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding LastTextMeta}" FontSize="11.5" Foreground="{DynamicResource Diktat.TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- A few earlier results -->
                    <StackPanel Visibility="{Binding HasHistory, Converter={StaticResource Diktat.BoolToVisibility}}">
                        <Grid Margin="2,0,0,6">
                            <TextBlock Text="Verlauf" Style="{DynamicResource Diktat.SectionHeaderText}" VerticalAlignment="Center"/>
                            <Button Content="Alle anzeigen" Style="{DynamicResource Diktat.LinkButton}" HorizontalAlignment="Right" Click="OnHistory"/>
                        </Grid>
                        <Border Style="{DynamicResource Diktat.CardStyle}" Padding="4">
                            <ItemsControl ItemsSource="{Binding RecentHistory}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{DynamicResource Diktat.RowButton}" Click="OnCopyHistory" Padding="10,7"
                                                ToolTip="Kopieren" AutomationProperties.Name="{Binding AutomationName}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                                <TextBlock FontSize="11.5" Foreground="{DynamicResource Diktat.TextSecondary}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding Meta}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Copied}" Value="True">
                                                                    <Setter Property="Text" Value="Kopiert"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </v:Stack>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource Diktat.Stroke}" BorderThickness="0,1,0,0" Padding="16,8,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Version}" FontSize="11.5" Foreground="{DynamicResource Diktat.TextTertiary}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Click="OnAudioFile" Padding="10,5" Margin="0,0,6,0"
                            ToolTip="Sprachmemo oder WhatsApp-Sprachnachricht transkribieren">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource Diktat.IconText}" Text="&#xE8D6;" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="Audiodatei"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Content="Beenden" Style="{DynamicResource Diktat.SubtleButton}" Padding="10,5"
                            Foreground="{DynamicResource Diktat.TextSecondary}" Click="OnQuit" ToolTip="Diktat beenden"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
