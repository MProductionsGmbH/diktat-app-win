<UserControl x:Class="Diktat.Windows.Views.Controls.SystemSoundTestPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Diktat.Windows.Views"
             xmlns:v="clr-namespace:Diktat.Windows.Views"
             xmlns:c="clr-namespace:Diktat.Windows.Views.Controls">
    <v:Stack Spacing="6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="TestButton" Content="{l:T 'Ton testen'}" Click="OnTest" HorizontalAlignment="Left"/>
            <c:LevelBars x:Name="Bars" Grid.Column="1" Height="24" BarCount="32" Margin="12,0,0,0" Visibility="Collapsed"
                         Fill="{DynamicResource Diktat.Mode.Night}" AutomationProperties.Name="{l:T 'Pegel des System-Audios'}"/>
        </Grid>
        <TextBlock x:Name="Status" Style="{DynamicResource Diktat.CaptionText}"
                   Text="{l:T 'Prüft, ob das System-Audio bei Diktat ankommt. Spiel dazu etwas ab, zum Beispiel das Meeting. Es wird nichts aufgenommen.'}"/>
    </v:Stack>
</UserControl>
