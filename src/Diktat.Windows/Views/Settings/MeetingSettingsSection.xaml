<UserControl x:Class="Diktat.Windows.Views.SettingsSections.MeetingSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Diktat.Windows.Views"
             xmlns:v="clr-namespace:Diktat.Windows.Views"
             xmlns:c="clr-namespace:Diktat.Windows.Views.Controls">
    <v:Stack Spacing="22">
        <HeaderedContentControl Header="{l:T 'Meetings'}" Style="{DynamicResource Diktat.Section}">
            <v:Stack Spacing="14">
                <v:Stack Spacing="8">
                    <TextBlock Text="{l:T 'Standardquelle'}" Style="{DynamicResource Diktat.CaptionText}"/>
                    <ListBox x:Name="Sources" Style="{DynamicResource Diktat.Segmented}" HorizontalAlignment="Left" MinWidth="420"
                             SelectionChanged="OnSourceChanged" AutomationProperties.Name="{l:T 'Standardquelle'}"/>
                    <TextBlock x:Name="SourceExplanation" Style="{DynamicResource Diktat.CaptionText}"/>
                </v:Stack>
                <CheckBox x:Name="SuggestOnCall" Click="OnSuggestOnCallClick">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Bei Anrufen eine Aufnahme vorschlagen'}" FontWeight="SemiBold"/>
                        <TextBlock Style="{DynamicResource Diktat.CaptionText}" Margin="0,2,0,0"
                                   Text="{l:T 'Öffnet Teams, Zoom, Meet oder eine andere Anruf-App das Mikrofon, zeigt Diktat eine Mitteilung. Dazu sieht Diktat nur, welche Apps Ton nutzen, nie was gesprochen wird. Aufgenommen wird erst, wenn du es startest.'}"/>
                    </StackPanel>
                </CheckBox>
                <CheckBox x:Name="Summarize" Click="OnSummarizeClick">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Nach dem Meeting automatisch zusammenfassen'}" FontWeight="SemiBold"/>
                        <TextBlock Style="{DynamicResource Diktat.CaptionText}" Margin="0,2,0,0"
                                   Text="{l:T 'Diktat schreibt nach dem Meeting eine Zusammenfassung mit Entscheidungen und To-dos. Ausgeschaltet bekommst du nur das Transkript mit den Personen; die Zusammenfassung kannst du später starten.'}"/>
                    </StackPanel>
                </CheckBox>
                <Border x:Name="SummaryNotice" Style="{DynamicResource Diktat.Notice}">
                    <TextBlock x:Name="SummaryNote" Style="{DynamicResource Diktat.CaptionText}"/>
                </Border>
                <Button Content="{l:T 'Modell auf diesem PC einrichten'}" Style="{DynamicResource Diktat.LinkButton}" Click="OnProvider"/>
            </v:Stack>
        </HeaderedContentControl>

        <HeaderedContentControl Header="{l:T 'System-Audio'}" Style="{DynamicResource Diktat.Section}">
            <v:Stack Spacing="10">
                <TextBlock Style="{DynamicResource Diktat.CaptionText}"
                           Text="{l:T 'Für Online-Meetings nimmt Diktat den Ton auf, den dein PC abspielt, zum Beispiel die Stimmen aus Teams, Zoom oder Meet. Windows braucht dafür keine Freigabe. Diktat nimmt auf, was über das Standard-Ausgabegerät von Windows läuft. Spielt die Anruf-App über ein anderes Gerät, kommt nichts an.'}"/>
                <c:SystemSoundTestPanel x:Name="SoundTest"/>
            </v:Stack>
        </HeaderedContentControl>

        <HeaderedContentControl Header="{l:T 'Sprecher-Erkennung'}" Style="{DynamicResource Diktat.Section}">
            <v:Stack Spacing="10">
                <TextBlock x:Name="SpeakerState" FontWeight="SemiBold"/>
                <TextBlock Style="{DynamicResource Diktat.CaptionText}"
                           Text="{l:T 'Unterscheidet in Meetings die Stimmen (Person 1, Person 2, ...). Das Paket ist rund 33 MB groß und läuft auf diesem PC.'}"/>
                <Button Content="{l:T 'Unter Modelle verwalten'}" Style="{DynamicResource Diktat.LinkButton}" Click="OnModels"/>
            </v:Stack>
        </HeaderedContentControl>

        <HeaderedContentControl Header="{l:T 'Aufnahmen'}" Style="{DynamicResource Diktat.Section}">
            <v:Stack Spacing="10">
                <TextBlock Style="{DynamicResource Diktat.CaptionText}"
                           Text="{l:T 'Meetings bleiben verschlüsselt für dein Windows-Konto auf diesem PC. Die Aufnahme selbst wird nach der Auswertung gelöscht. Bitte frag alle, bevor du aufnimmst.'}"/>
                <Button Content="{l:T 'Meetings öffnen'}" HorizontalAlignment="Left" Click="OnMeetings"/>
            </v:Stack>
        </HeaderedContentControl>
    </v:Stack>
</UserControl>
