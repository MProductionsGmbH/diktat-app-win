<UserControl x:Class="Diktat.Windows.Views.SettingsSections.MeetingSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Diktat.Windows.Views">
    <v:Stack Spacing="22">
        <HeaderedContentControl Header="Meetings" Style="{DynamicResource Diktat.Section}">
            <v:Stack Spacing="14">
                <CheckBox x:Name="Summarize" Click="OnSummarizeClick">
                    <StackPanel>
                        <TextBlock Text="Nach dem Meeting automatisch zusammenfassen" FontWeight="SemiBold"/>
                        <TextBlock Style="{DynamicResource Diktat.CaptionText}" Margin="0,2,0,0"
                                   Text="Diktat schreibt nach dem Meeting eine Zusammenfassung mit Entscheidungen und To-dos. Ausgeschaltet bekommst du nur das Transkript mit den Personen; die Zusammenfassung kannst du später starten."/>
                    </StackPanel>
                </CheckBox>
                <Border x:Name="SummaryNotice" Style="{DynamicResource Diktat.Notice}">
                    <TextBlock x:Name="SummaryNote" Style="{DynamicResource Diktat.CaptionText}"/>
                </Border>
                <Button Content="Modell auf diesem PC einrichten" Style="{DynamicResource Diktat.LinkButton}" Click="OnProvider"/>
            </v:Stack>
        </HeaderedContentControl>

        <HeaderedContentControl Header="Sprecher-Erkennung" Style="{DynamicResource Diktat.Section}">
            <v:Stack Spacing="10">
                <TextBlock x:Name="SpeakerState" FontWeight="SemiBold"/>
                <TextBlock Style="{DynamicResource Diktat.CaptionText}"
                           Text="Unterscheidet in Meetings die Stimmen (Person 1, Person 2, ...). Das Paket ist rund 33 MB groß und läuft auf diesem PC."/>
                <Button Content="Unter Modelle verwalten" Style="{DynamicResource Diktat.LinkButton}" Click="OnModels"/>
            </v:Stack>
        </HeaderedContentControl>

        <HeaderedContentControl Header="Aufnahmen" Style="{DynamicResource Diktat.Section}">
            <v:Stack Spacing="10">
                <TextBlock Style="{DynamicResource Diktat.CaptionText}"
                           Text="Meetings bleiben verschlüsselt für dein Windows-Konto auf diesem PC. Die Aufnahme selbst wird nach der Auswertung gelöscht. Bitte frag alle, bevor du aufnimmst."/>
                <Button Content="Meetings öffnen" HorizontalAlignment="Left" Click="OnMeetings"/>
            </v:Stack>
        </HeaderedContentControl>
    </v:Stack>
</UserControl>
