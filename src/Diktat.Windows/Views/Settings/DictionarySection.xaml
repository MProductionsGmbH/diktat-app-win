<UserControl x:Class="Diktat.Windows.Views.SettingsSections.DictionarySection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Diktat.Windows.Views"
             xmlns:v="clr-namespace:Diktat.Windows.Views">
    <v:Stack Spacing="22">
        <HeaderedContentControl Header="{l:T 'Eigennamen'}" Style="{DynamicResource Diktat.Section}">
            <v:Stack Spacing="12">
                <TextBlock Style="{DynamicResource Diktat.CaptionText}"
                           Text="{l:T 'Namen und Fachbegriffe, die Diktat genau so schreiben soll. KI-Modi übernehmen sie unverändert.'}"/>
                <ItemsControl x:Name="Terms" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="14" Background="{DynamicResource Diktat.Inset}" BorderBrush="{DynamicResource Diktat.Stroke}" BorderThickness="1"
                                    Padding="10,2,2,2" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" FontSize="13"/>
                                    <Button Style="{DynamicResource Diktat.IconButton}" Content="&#xE711;" FontSize="9" Width="24" Height="24" Margin="4,0,0,0"
                                            Click="OnRemoveTerm" ToolTip="{l:T 'Entfernen'}" AutomationProperties.Name="{Binding StringFormat={l:T '\{0\} entfernen'}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewTerm" v:Hint.Text="{l:T 'Neuer Begriff, z. B. WhiteRabbit'}" KeyDown="OnTermKey" AutomationProperties.Name="{l:T 'Neuer Begriff'}"/>
                    <Button Grid.Column="1" Content="{l:T 'Hinzufügen'}" Margin="8,0,0,0" Click="OnAddTerm"/>
                </Grid>
                <Separator Style="{DynamicResource Diktat.Divider}"/>
                <CheckBox x:Name="CorrectTerms" Click="OnCorrectTermsClick">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Eigennamen automatisch korrigieren'}" FontWeight="SemiBold"/>
                        <TextBlock Style="{DynamicResource Diktat.CaptionText}" Margin="0,2,0,0"
                                   Text="{l:T 'Korrigiert ähnlich klingende Schreibweisen auf deine Eigennamen, z. B. „White Rabbit“ zu „WhiteRabbit“. Echte Wörter bleiben unverändert.'}"/>
                    </StackPanel>
                </CheckBox>
            </v:Stack>
        </HeaderedContentControl>

        <HeaderedContentControl Header="{l:T 'Ersetzungen'}" Style="{DynamicResource Diktat.Section}">
            <v:Stack Spacing="12">
                <TextBlock Style="{DynamicResource Diktat.CaptionText}"
                           Text="{l:T 'Für Begriffe, die anders klingen, als sie geschrieben werden. Zum Beispiel wird aus „n acht n“ immer „n8n“.'}"/>
                <ItemsControl x:Name="Replacements" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Spoken}" Foreground="{DynamicResource Diktat.TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Style="{DynamicResource Diktat.IconText}" Text="&#xE72A;" FontSize="11" Margin="10,0"
                                           Foreground="{DynamicResource Diktat.TextTertiary}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Written}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="3" Style="{DynamicResource Diktat.IconButton}" Content="&#xE711;" FontSize="10" Click="OnRemoveReplacement"
                                        ToolTip="{l:T 'Ersetzung entfernen'}" AutomationProperties.Name="{Binding Spoken, StringFormat={l:T 'Ersetzung für \{0\} entfernen'}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewSpoken" v:Hint.Text="{l:T 'Gesprochen'}" AutomationProperties.Name="{l:T 'Gesprochen'}" KeyDown="OnReplacementKey"/>
                    <TextBlock Grid.Column="1" Style="{DynamicResource Diktat.IconText}" Text="&#xE72A;" FontSize="11" Margin="10,0"
                               Foreground="{DynamicResource Diktat.TextTertiary}"/>
                    <TextBox x:Name="NewWritten" Grid.Column="2" v:Hint.Text="{l:T 'Geschrieben'}" AutomationProperties.Name="{l:T 'Geschrieben'}" KeyDown="OnReplacementKey"/>
                    <Button Grid.Column="3" Content="{l:T 'Hinzufügen'}" Margin="8,0,0,0" Click="OnAddReplacement"/>
                </Grid>
                <TextBlock x:Name="ReplacementError" Style="{DynamicResource Diktat.ErrorTextStyle}" Visibility="Collapsed"/>
            </v:Stack>
        </HeaderedContentControl>

        <HeaderedContentControl Header="{l:T 'Füllwörter'}" Style="{DynamicResource Diktat.Section}">
            <CheckBox x:Name="RemoveFillers" Click="OnRemoveFillersClick" Content="{l:T '„Äh“ und „ähm“ entfernen'}"/>
        </HeaderedContentControl>
    </v:Stack>
</UserControl>
