<UserControl x:Class="Diktat.Windows.Views.SettingsSections.ModelsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Diktat.Windows.Views"
             xmlns:v="clr-namespace:Diktat.Windows.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="ModelTemplate">
            <Border Style="{DynamicResource Diktat.InsetCard}" Margin="0,0,0,10" Padding="14,12" AutomationProperties.Name="{Binding AutomationName}">
                <v:Stack Spacing="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding Size}" FontSize="12" Foreground="{DynamicResource Diktat.TextTertiary}" Margin="8,0,0,0"
                                           VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" Style="{DynamicResource Diktat.CaptionText}" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Languages}" Style="{DynamicResource Diktat.SmallText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="9" Padding="8,2" VerticalAlignment="Top" Margin="10,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Diktat.Hover}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Diktat.SuccessSoft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StateText}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Diktat.TextSecondary}"/>
                        </Border>
                    </Grid>

                    <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource Diktat.BoolToVisibility}}">
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" AutomationProperties.Name="{Binding ProgressText}"/>
                        <TextBlock Text="{Binding ProgressText}" Style="{DynamicResource Diktat.CaptionText}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Error}" Style="{DynamicResource Diktat.ErrorTextStyle}"
                               Visibility="{Binding Error, Converter={StaticResource Diktat.EmptyToCollapsed}}"/>

                    <WrapPanel>
                        <Button Content="{l:T 'Laden'}" Style="{DynamicResource Diktat.PrimaryButton}" Padding="14,6" Margin="0,0,8,0" Click="OnDownload"
                                Visibility="{Binding CanDownload, Converter={StaticResource Diktat.BoolToVisibility}}"
                                AutomationProperties.Name="{Binding Name, StringFormat={l:T '\{0\} laden'}}"/>
                        <Button Content="{l:T 'Abbrechen'}" Padding="14,6" Margin="0,0,8,0" Click="OnCancel"
                                Visibility="{Binding IsDownloading, Converter={StaticResource Diktat.BoolToVisibility}}"/>
                        <Button Content="{l:T 'Verwenden'}" Padding="14,6" Margin="0,0,8,0" Click="OnSelect"
                                Visibility="{Binding CanSelect, Converter={StaticResource Diktat.BoolToVisibility}}"
                                AutomationProperties.Name="{Binding Name, StringFormat={l:T '\{0\} verwenden'}}"/>
                        <Button Content="{l:T 'Löschen'}" Style="{DynamicResource Diktat.DangerButton}" Padding="10,6" Click="OnDelete"
                                Visibility="{Binding CanDelete, Converter={StaticResource Diktat.BoolToVisibility}}"
                                AutomationProperties.Name="{Binding Name, StringFormat={l:T '\{0\} löschen'}}"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding Attribution}" Style="{DynamicResource Diktat.SmallText}" FontSize="11"
                               Visibility="{Binding Attribution, Converter={StaticResource Diktat.EmptyToCollapsed}}"/>
                </v:Stack>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <v:Stack Spacing="22">
        <HeaderedContentControl Header="{l:T 'Spracherkennung'}" Style="{DynamicResource Diktat.Section}">
            <v:Stack Spacing="12">
                <TextBlock Style="{DynamicResource Diktat.CaptionText}" Text="{l:T 'Diktat transkribiert immer auf diesem PC. Das Audio verlässt das Gerät nicht. Ein Modell wird einmalig von Hugging Face geladen.'}"/>
                <TextBlock Text="{Binding InstalledSummary}" FontWeight="SemiBold" FontSize="13"/>
                <ItemsControl ItemsSource="{Binding TranscriptionModels}" ItemTemplate="{StaticResource ModelTemplate}" Focusable="False"/>
            </v:Stack>
        </HeaderedContentControl>

        <HeaderedContentControl Header="{l:T 'Sprache'}" Style="{DynamicResource Diktat.Section}">
            <v:Stack Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:T 'Diktiersprache'}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding Language}" AutomationProperties.Name="{l:T 'Diktiersprache'}"/>
                </Grid>
                <TextBlock Text="{Binding LanguageNote}" Style="{DynamicResource Diktat.CaptionText}"/>
            </v:Stack>
        </HeaderedContentControl>

        <HeaderedContentControl Header="{l:T 'Meetings'}" Style="{DynamicResource Diktat.Section}">
            <v:Stack Spacing="10">
                <TextBlock Style="{DynamicResource Diktat.CaptionText}"
                           Text="{l:T 'Optional: Das Paket „Sprecher-Erkennung“ unterscheidet in Meetings die Stimmen (Person 1, Person 2, ...). Ohne das Paket steht im Transkript alles bei einer Person.'}"/>
                <ContentControl Content="{Binding SpeakerModel}" ContentTemplate="{StaticResource ModelTemplate}" Focusable="False"/>
            </v:Stack>
        </HeaderedContentControl>
    </v:Stack>
</UserControl>
