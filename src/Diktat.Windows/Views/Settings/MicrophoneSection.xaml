<UserControl x:Class="Diktat.Windows.Views.SettingsSections.MicrophoneSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Diktat.Windows.Views"
             xmlns:c="clr-namespace:Diktat.Windows.Views.Controls">
    <v:Stack Spacing="22">
        <HeaderedContentControl Header="Mikrofon" Style="{DynamicResource Diktat.Section}">
            <v:Stack Spacing="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="Devices" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnDeviceChanged"
                              AutomationProperties.Name="Mikrofon"/>
                    <Button Grid.Column="1" Style="{DynamicResource Diktat.IconButton}" Content="&#xE72C;" Margin="6,0,0,0" Click="OnRefresh"
                            ToolTip="Liste aktualisieren" AutomationProperties.Name="Mikrofone neu suchen"/>
                </Grid>
                <Border x:Name="MissingNotice" Style="{DynamicResource Diktat.Notice}" Visibility="Collapsed">
                    <TextBlock Style="{DynamicResource Diktat.CaptionText}"
                               Text="Das gewählte Mikrofon ist nicht angeschlossen. Diktat nimmt so lange das Standardmikrofon von Windows."/>
                </Border>
                <TextBlock x:Name="ListError" Style="{DynamicResource Diktat.ErrorTextStyle}" Visibility="Collapsed"/>
                <TextBlock Style="{DynamicResource Diktat.CaptionText}"
                           Text="Mit dem Systemstandard folgt Diktat der Einstellung von Windows (Einstellungen, System, Sound, Eingabe). Wähle ein bestimmtes Mikrofon, wenn andere Programme ein anderes nutzen sollen. Die Auswahl gilt für das Diktieren und für Meetings."/>
                <Border x:Name="VolumeNotice" Style="{DynamicResource Diktat.ErrorNotice}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="VolumeTitle" FontWeight="SemiBold" Foreground="{DynamicResource Diktat.ErrorText}" TextWrapping="Wrap"/>
                            <TextBlock Style="{DynamicResource Diktat.CaptionText}" Text="Dann gehen Wörter verloren. In den Sound-Einstellungen unter Eingabe lauter stellen."/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Sound" Padding="12,5" Margin="10,0,0,0" Click="OnSoundSettings" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </v:Stack>
        </HeaderedContentControl>

        <HeaderedContentControl Header="Testen" Style="{DynamicResource Diktat.Section}">
            <v:Stack Spacing="12">
                <TextBlock Style="{DynamicResource Diktat.CaptionText}" Text="Ein paar Sekunden sprechen: Die Striche zeigen, was beim Mikrofon ankommt. Nichts wird gespeichert."/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="TestButton" Content="Mikrofon testen" Click="OnTest" Margin="0,0,14,0"/>
                    <c:LevelBars x:Name="TestBars" Grid.Column="1" Height="30" BarCount="40"/>
                </Grid>
                <TextBlock x:Name="TestResult" Style="{DynamicResource Diktat.CaptionText}" Visibility="Collapsed"/>
            </v:Stack>
        </HeaderedContentControl>

        <HeaderedContentControl Header="Datenschutz von Windows" Style="{DynamicResource Diktat.Section}">
            <v:Stack Spacing="10">
                <TextBlock Style="{DynamicResource Diktat.CaptionText}"
                           Text="Windows muss Desktop-Apps den Zugriff auf das Mikrofon erlauben. Hört Diktat nichts, dort „Desktop-Apps den Zugriff auf Ihr Mikrofon erlauben“ einschalten."/>
                <WrapPanel>
                    <Button Content="Mikrofon-Datenschutz öffnen" Click="OnPrivacySettings" Margin="0,0,8,0"/>
                    <Button Content="Sound-Einstellungen öffnen" Click="OnSoundSettings"/>
                </WrapPanel>
            </v:Stack>
        </HeaderedContentControl>
    </v:Stack>
</UserControl>
