<Window x:Class="Diktat.Windows.Views.SetupAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Diktat.Windows.Views"
        xmlns:v="clr-namespace:Diktat.Windows.Views"
        xmlns:c="clr-namespace:Diktat.Windows.Views.Controls"
        Title="{l:T 'Diktat einrichten'}"
        Width="700" Height="640" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Icon="pack://application:,,,/Assets/Diktat.ico"
        FontFamily="{DynamicResource Diktat.Font}" FontSize="13.5"
        Foreground="{DynamicResource Diktat.Text}"
        Background="{DynamicResource Diktat.Page}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Steps -->
        <Border Padding="28,20,28,14">
            <ItemsControl x:Name="StepList" Focusable="False" AutomationProperties.Name="{l:T 'Schritte'}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type v:SetupStep}">
                        <StackPanel Margin="0,0,6,0" AutomationProperties.Name="{Binding AutomationName}">
                            <Border x:Name="Bar" Height="4" CornerRadius="2" Background="{DynamicResource Diktat.Inset}"/>
                            <TextBlock x:Name="Label" Text="{Binding Title}" FontSize="11.5" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Diktat.TextTertiary}"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Diktat.Tonal}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Diktat.TextSecondary}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Diktat.Accent}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Diktat.Text}"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Style="{DynamicResource Diktat.PageScroller}">
            <Grid Margin="28,6,28,20">

                <!-- 1 Willkommen -->
                <v:Stack x:Name="WelcomeStep" Spacing="16">
                    <Image Source="pack://application:,,,/Assets/icon-256.png" Width="88" Height="88" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Diktat"/>
                    <StackPanel>
                        <TextBlock Text="{l:T 'Willkommen'}" Style="{DynamicResource Diktat.TitleText}" FontSize="30"/>
                        <TextBlock Text="{l:T 'bei Diktat'}" Style="{DynamicResource Diktat.TitleText}" FontSize="30" Foreground="{DynamicResource Diktat.Accent}"/>
                    </StackPanel>
                    <TextBlock Style="{DynamicResource Diktat.BodyText}" FontSize="14.5"
                               Text="{l:T 'Kürzel halten, sprechen, loslassen: Diktat schreibt den Text dort, wo dein Cursor steht. Die Sprache wird direkt auf diesem PC erkannt, ohne Konto und ohne Cloud.'}"/>
                    <Border Style="{DynamicResource Diktat.CardStyle}">
                        <v:Stack Spacing="10">
                            <TextBlock Text="{l:T 'In ein paar Minuten eingerichtet:'}" FontWeight="SemiBold"/>
                            <TextBlock Style="{DynamicResource Diktat.CaptionText}" Text="{l:T '1. Mikrofon prüfen'}"/>
                            <TextBlock Style="{DynamicResource Diktat.CaptionText}" Text="{l:T '2. Sprachmodell laden, einmalig'}"/>
                            <TextBlock Style="{DynamicResource Diktat.CaptionText}" Text="{l:T '3. Kurzbefehl ausprobieren'}"/>
                            <TextBlock Style="{DynamicResource Diktat.CaptionText}" Text="{l:T '4. KI-Modell laden für KI-Schreibstil, WTF und :-), einmalig'}"/>
                        </v:Stack>
                    </Border>
                </v:Stack>

                <!-- 2 Mikrofon -->
                <v:Stack x:Name="MicrophoneStep" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="{l:T 'Mikrofon'}" Style="{DynamicResource Diktat.TitleText}"/>
                    <TextBlock Style="{DynamicResource Diktat.BodyText}" Text="{l:T 'Damit Diktat hört, was du sagst. Die Aufnahme bleibt auf diesem PC und wird nach dem Diktat gelöscht.'}"/>
                    <Border x:Name="MicDenied" Style="{DynamicResource Diktat.ErrorNotice}" Visibility="Collapsed">
                        <v:Stack Spacing="10">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Diktat.ErrorText}" TextWrapping="Wrap"
                                       Text="{l:T 'Windows erlaubt Desktop-Apps gerade nicht, das Mikrofon zu nutzen.'}"/>
                            <TextBlock Style="{DynamicResource Diktat.CaptionText}"
                                       Text="{l:T 'In den Einstellungen unter Datenschutz und Sicherheit, Mikrofon, „Zugriff auf das Mikrofon“ und „Desktop-Apps den Zugriff auf Ihr Mikrofon erlauben“ einschalten. Danach hier „Erneut prüfen“.'}"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{l:T 'Mikrofon-Datenschutz öffnen'}" Style="{DynamicResource Diktat.PrimaryButton}" Click="OnOpenMicPrivacy" Margin="0,0,8,0"/>
                                <Button Content="{l:T 'Erneut prüfen'}" Click="OnRecheckMic"/>
                            </StackPanel>
                        </v:Stack>
                    </Border>
                    <Border x:Name="MicNone" Style="{DynamicResource Diktat.ErrorNotice}" Visibility="Collapsed">
                        <v:Stack Spacing="10">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Diktat.ErrorText}" Text="{l:T 'Kein Mikrofon gefunden.'}" TextWrapping="Wrap"/>
                            <TextBlock Style="{DynamicResource Diktat.CaptionText}" Text="{l:T 'Schließ ein Headset oder ein Mikrofon an. Am Laptop hilft oft schon, den Deckel aufzuklappen.'}"/>
                            <Button Content="{l:T 'Erneut prüfen'}" HorizontalAlignment="Left" Click="OnRecheckMic"/>
                        </v:Stack>
                    </Border>
                    <Border x:Name="MicOk" Style="{DynamicResource Diktat.CardStyle}" Visibility="Collapsed">
                        <v:Stack Spacing="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{DynamicResource Diktat.IconText}" Text="&#xE73E;" Foreground="{DynamicResource Diktat.SuccessText}" Margin="0,0,8,0"/>
                                <TextBlock Text="{l:T 'Diktat darf das Mikrofon nutzen.'}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{l:T 'Mikrofon'}" Style="{DynamicResource Diktat.CaptionText}"/>
                            <ComboBox x:Name="MicPicker" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnMicPicked"
                                      AutomationProperties.Name="{l:T 'Mikrofon'}"/>
                            <TextBlock x:Name="MicVolume" Style="{DynamicResource Diktat.ErrorTextStyle}" Visibility="Collapsed"/>
                        </v:Stack>
                    </Border>
                </v:Stack>

                <!-- 3 Sprachmodell -->
                <v:Stack x:Name="ModelStep" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="{l:T 'Sprachmodell laden'}" Style="{DynamicResource Diktat.TitleText}"/>
                    <TextBlock Style="{DynamicResource Diktat.BodyText}"
                               Text="{l:T 'Das Sprachmodell erkennt deine Sprache direkt auf diesem PC. Es wird einmalig geladen, danach geht es ohne Internet.'}"/>
                    <Border Style="{DynamicResource Diktat.CardStyle}">
                        <v:Stack Spacing="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ModelName" FontWeight="SemiBold" FontSize="14.5"/>
                                <TextBlock x:Name="ModelSize" Foreground="{DynamicResource Diktat.TextTertiary}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock x:Name="ModelDetail" Style="{DynamicResource Diktat.CaptionText}"/>
                            <StackPanel x:Name="ModelProgressPanel" Visibility="Collapsed">
                                <ProgressBar x:Name="ModelProgress" AutomationProperties.Name="{l:T 'Sprachmodell wird geladen'}"/>
                                <TextBlock x:Name="ModelProgressText" Style="{DynamicResource Diktat.CaptionText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="ModelError" Style="{DynamicResource Diktat.ErrorTextStyle}" Visibility="Collapsed"/>
                            <StackPanel x:Name="ModelInstalled" Orientation="Horizontal" Visibility="Collapsed">
                                <TextBlock Style="{DynamicResource Diktat.IconText}" Text="&#xE73E;" Foreground="{DynamicResource Diktat.SuccessText}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ModelInstalledText" Style="{DynamicResource Diktat.SuccessTextStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ModelDownloadButton" Style="{DynamicResource Diktat.PrimaryButton}" Click="OnDownloadModel" Margin="0,0,8,0"/>
                                <Button x:Name="ModelCancelButton" Content="{l:T 'Abbrechen'}" Click="OnCancelModel" Visibility="Collapsed"/>
                            </StackPanel>
                        </v:Stack>
                    </Border>
                    <TextBlock Style="{DynamicResource Diktat.SmallText}"
                               Text="{l:T 'Andere Modelle wie Whisper für rund 100 Sprachen findest du später unter Einstellungen, Modelle.'}"/>
                </v:Stack>

                <!-- 4 Kurzbefehl -->
                <v:Stack x:Name="TryStep" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="{l:T 'Kurzbefehl ausprobieren'}" Style="{DynamicResource Diktat.TitleText}"/>
                    <TextBlock x:Name="TryTitle" Style="{DynamicResource Diktat.HeadingText}"/>
                    <TextBlock Style="{DynamicResource Diktat.BodyText}"
                               Text="{l:T 'Klick in das Feld unten, halte das Kürzel, sag einen Satz und lass los. Der Text landet dort, wo dein Cursor steht, in jeder App.'}"/>
                    <TextBox x:Name="TryBox" Style="{DynamicResource Diktat.MultilineTextBox}" Height="110" v:Hint.Text="{l:T 'Hier hinein diktieren …'}"
                             AutomationProperties.Name="{l:T 'Probefeld zum Diktieren'}"/>
                    <Border x:Name="TryStatus" Style="{DynamicResource Diktat.Notice}" Visibility="Collapsed">
                        <TextBlock x:Name="TryStatusText" TextWrapping="Wrap"/>
                    </Border>
                    <Border x:Name="TrySuccess" Style="{DynamicResource Diktat.SuccessNotice}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource Diktat.IconText}" Text="&#xE73E;" Foreground="{DynamicResource Diktat.SuccessText}" Margin="0,0,8,0"/>
                            <TextBlock Text="{l:T 'Geklappt! So geht es überall.'}" FontWeight="SemiBold" Foreground="{DynamicResource Diktat.SuccessText}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="TryModelMissing" Style="{DynamicResource Diktat.ErrorTextStyle}" Visibility="Collapsed"
                               Text="{l:T 'Ohne Sprachmodell kann Diktat nicht transkribieren. Geh einen Schritt zurück und lade das Modell.'}"/>
                    <TextBlock Style="{DynamicResource Diktat.SmallText}"
                               Text="{l:T 'Das Kürzel kannst du später unter Einstellungen, Allgemein ändern, auch auf „Umschalten“: einmal drücken zum Starten, nochmal zum Beenden.'}"/>
                </v:Stack>

                <!-- 5 KI-Modell -->
                <v:Stack x:Name="AIStep" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="{l:T 'KI-Modell laden'}" Style="{DynamicResource Diktat.TitleText}"/>
                    <TextBlock Style="{DynamicResource Diktat.BodyText}"
                               Text="{l:T 'Das KI-Modell überarbeitet deine Diktate: KI-Schreibstil, WTF, :-), die Glättung Mittel und Stark und die Meeting-Zusammenfassungen. Es läuft auf diesem PC, wird einmalig geladen und braucht danach kein Internet.'}"/>
                    <Border Style="{DynamicResource Diktat.CardStyle}">
                        <v:Stack Spacing="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LmName" FontWeight="SemiBold" FontSize="14.5"/>
                                <TextBlock x:Name="LmSize" Foreground="{DynamicResource Diktat.TextTertiary}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock x:Name="LmDetail" Style="{DynamicResource Diktat.CaptionText}"/>
                            <TextBlock x:Name="LmMemory" Style="{DynamicResource Diktat.ErrorTextStyle}" Visibility="Collapsed"/>
                            <StackPanel x:Name="LmProgressPanel" Visibility="Collapsed">
                                <ProgressBar x:Name="LmProgress" AutomationProperties.Name="{l:T 'KI-Modell wird geladen'}"/>
                                <TextBlock x:Name="LmProgressText" Style="{DynamicResource Diktat.CaptionText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="LmError" Style="{DynamicResource Diktat.ErrorTextStyle}" Visibility="Collapsed"/>
                            <StackPanel x:Name="LmInstalled" Orientation="Horizontal" Visibility="Collapsed">
                                <TextBlock Style="{DynamicResource Diktat.IconText}" Text="&#xE73E;" Foreground="{DynamicResource Diktat.SuccessText}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="LmInstalledText" Style="{DynamicResource Diktat.SuccessTextStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LmDownloadButton" Style="{DynamicResource Diktat.PrimaryButton}" Click="OnDownloadLanguageModel" Margin="0,0,8,0"/>
                                <Button x:Name="LmCancelButton" Content="{l:T 'Abbrechen'}" Click="OnCancelLanguageModel" Visibility="Collapsed"/>
                            </StackPanel>
                        </v:Stack>
                    </Border>
                    <TextBlock x:Name="LmRunningHint" Style="{DynamicResource Diktat.SmallText}" Visibility="Collapsed"
                               Text="{l:T 'Du kannst schon weiter. Der Download läuft im Hintergrund fertig, auch wenn du den Assistenten schließt.'}"/>
                    <TextBlock x:Name="LmNeeded" Style="{DynamicResource Diktat.SmallText}" Visibility="Collapsed"
                               Text="{l:T 'Lade das KI-Modell oder richte unten einen eigenen Anbieter ein, dann geht es weiter.'}"/>
                    <TextBlock x:Name="LmBigger" Style="{DynamicResource Diktat.SmallText}" Visibility="Collapsed"
                               Text="{l:T 'Gründlicher ist Gemma 4 E4B (5,2 GB). Du findest es später unter Einstellungen, Modelle.'}"/>
                    <Button x:Name="ProviderToggle" Style="{DynamicResource Diktat.SubtleButton}" HorizontalAlignment="Left" Click="OnToggleProvider"
                            Content="{l:T 'Lieber eigenen Anbieter oder Ollama verwenden'}"/>
                    <ContentControl x:Name="AIHost" Focusable="False" Visibility="Collapsed"/>
                </v:Stack>

                <!-- 6 Fertig -->
                <v:Stack x:Name="DoneStep" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="{l:T 'Fertig'}" Style="{DynamicResource Diktat.TitleText}" FontSize="30"/>
                    <TextBlock Style="{DynamicResource Diktat.BodyText}"
                               Text="{l:T 'Diktat wartet unsichtbar im Infobereich der Taskleiste. Ein Klick auf das Symbol zeigt die Modi, den letzten Text und den Verlauf.'}"/>
                    <Border x:Name="DoneLoading" Style="{DynamicResource Diktat.Notice}" Visibility="Collapsed">
                        <TextBlock x:Name="DoneLoadingText" TextWrapping="Wrap"/>
                    </Border>
                    <Border Style="{DynamicResource Diktat.CardStyle}">
                        <ItemsControl x:Name="DoneModes" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <c:ModeIcon Mode="{Binding Mode}" Size="32"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource Diktat.TextSecondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <c:HotkeyBadge Grid.Column="2" Label="{Binding Hotkey}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Style="{DynamicResource Diktat.SmallText}" Text="{l:T 'Verlauf, Modi, Meetings und Einstellungen findest du im Diktat-Fenster.'}"/>
                </v:Stack>
            </Grid>
        </ScrollViewer>

        <!-- Navigation -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Diktat.Stroke}" BorderThickness="0,1,0,0" Padding="28,12" Background="{DynamicResource Diktat.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="LaterButton" Content="{l:T 'Später'}" Style="{DynamicResource Diktat.SubtleButton}" Click="OnLater"
                        Foreground="{DynamicResource Diktat.TextSecondary}" ToolTip="{l:T 'Den Assistenten schließen. Er bleibt im Infobereich erreichbar.'}"/>
                <Button x:Name="BackButton" Grid.Column="2" Content="{l:T 'Zurück'}" Click="OnBack" Margin="0,0,8,0"/>
                <Button x:Name="NextButton" Grid.Column="3" Content="{l:T 'Weiter'}" Style="{DynamicResource Diktat.PrimaryButton}" Click="OnNext" MinWidth="120"/>
            </Grid>
        </Border>
    </Grid>
</Window>
