<Window x:Class="Diktat.Windows.Views.SetupAssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Diktat.Windows.Views"
        xmlns:c="clr-namespace:Diktat.Windows.Views.Controls"
        Title="Diktat einrichten"
        Width="700" Height="640" MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        Icon="pack://application:,,,/Assets/Diktat.ico"
        FontFamily="{DynamicResource Diktat.Font}" FontSize="13.5"
        Foreground="{DynamicResource Diktat.Text}"
        Background="{DynamicResource Diktat.Page}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Steps -->
        <Border Padding="28,20,28,14">
            <ItemsControl x:Name="StepList" Focusable="False" AutomationProperties.Name="Schritte">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type v:SetupStep}">
                        <StackPanel Margin="0,0,6,0" AutomationProperties.Name="{Binding AutomationName}">
                            <Border x:Name="Bar" Height="4" CornerRadius="2" Background="{DynamicResource Diktat.Inset}"/>
                            <TextBlock x:Name="Label" Text="{Binding Title}" FontSize="11.5" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Diktat.TextTertiary}"/>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Diktat.Tonal}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Diktat.TextSecondary}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Diktat.Accent}"/>
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Diktat.Text}"/>
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Style="{DynamicResource Diktat.PageScroller}">
            <Grid Margin="28,6,28,20">

                <!-- 1 Willkommen -->
                <v:Stack x:Name="WelcomeStep" Spacing="16">
                    <Image Source="pack://application:,,,/Assets/icon-256.png" Width="88" Height="88" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Diktat"/>
                    <StackPanel>
                        <TextBlock Text="Willkommen" Style="{DynamicResource Diktat.TitleText}" FontSize="30"/>
                        <TextBlock Text="bei Diktat" Style="{DynamicResource Diktat.TitleText}" FontSize="30" Foreground="{DynamicResource Diktat.Accent}"/>
                    </StackPanel>
                    <TextBlock Style="{DynamicResource Diktat.BodyText}" FontSize="14.5"
                               Text="Kürzel halten, sprechen, loslassen: Diktat schreibt den Text dort, wo dein Cursor steht. Die Sprache wird direkt auf diesem PC erkannt, ohne Konto und ohne Cloud."/>
                    <Border Style="{DynamicResource Diktat.Card}">
                        <v:Stack Spacing="10">
                            <TextBlock Text="In ein paar Minuten eingerichtet:" FontWeight="SemiBold"/>
                            <TextBlock Style="{DynamicResource Diktat.CaptionText}" Text="1. Mikrofon prüfen"/>
                            <TextBlock Style="{DynamicResource Diktat.CaptionText}" Text="2. Sprachmodell laden, einmalig"/>
                            <TextBlock Style="{DynamicResource Diktat.CaptionText}" Text="3. Kurzbefehl ausprobieren"/>
                            <TextBlock Style="{DynamicResource Diktat.CaptionText}" Text="4. Optional: KI-Anbieter für KI-Schreibstil, WTF und :-)"/>
                        </v:Stack>
                    </Border>
                </v:Stack>

                <!-- 2 Mikrofon -->
                <v:Stack x:Name="MicrophoneStep" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="Mikrofon" Style="{DynamicResource Diktat.TitleText}"/>
                    <TextBlock Style="{DynamicResource Diktat.BodyText}" Text="Damit Diktat hört, was du sagst. Die Aufnahme bleibt auf diesem PC und wird nach dem Diktat gelöscht."/>
                    <Border x:Name="MicDenied" Style="{DynamicResource Diktat.ErrorNotice}" Visibility="Collapsed">
                        <v:Stack Spacing="10">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Diktat.ErrorText}" TextWrapping="Wrap"
                                       Text="Windows erlaubt Desktop-Apps gerade nicht, das Mikrofon zu nutzen."/>
                            <TextBlock Style="{DynamicResource Diktat.CaptionText}"
                                       Text="In den Einstellungen unter Datenschutz und Sicherheit, Mikrofon, „Zugriff auf das Mikrofon“ und „Desktop-Apps den Zugriff auf Ihr Mikrofon erlauben“ einschalten. Danach hier „Erneut prüfen“."/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Mikrofon-Datenschutz öffnen" Style="{DynamicResource Diktat.PrimaryButton}" Click="OnOpenMicPrivacy" Margin="0,0,8,0"/>
                                <Button Content="Erneut prüfen" Click="OnRecheckMic"/>
                            </StackPanel>
                        </v:Stack>
                    </Border>
                    <Border x:Name="MicNone" Style="{DynamicResource Diktat.ErrorNotice}" Visibility="Collapsed">
                        <v:Stack Spacing="10">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Diktat.ErrorText}" Text="Kein Mikrofon gefunden." TextWrapping="Wrap"/>
                            <TextBlock Style="{DynamicResource Diktat.CaptionText}" Text="Schließ ein Headset oder ein Mikrofon an. Am Laptop hilft oft schon, den Deckel aufzuklappen."/>
                            <Button Content="Erneut prüfen" HorizontalAlignment="Left" Click="OnRecheckMic"/>
                        </v:Stack>
                    </Border>
                    <Border x:Name="MicOk" Style="{DynamicResource Diktat.Card}" Visibility="Collapsed">
                        <v:Stack Spacing="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{DynamicResource Diktat.IconText}" Text="&#xE73E;" Foreground="{DynamicResource Diktat.SuccessText}" Margin="0,0,8,0"/>
                                <TextBlock Text="Diktat darf das Mikrofon nutzen." FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="Mikrofon" Style="{DynamicResource Diktat.CaptionText}"/>
                            <ComboBox x:Name="MicPicker" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="OnMicPicked"
                                      AutomationProperties.Name="Mikrofon"/>
                            <TextBlock x:Name="MicVolume" Style="{DynamicResource Diktat.ErrorText}" Visibility="Collapsed"/>
                        </v:Stack>
                    </Border>
                </v:Stack>

                <!-- 3 Sprachmodell -->
                <v:Stack x:Name="ModelStep" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="Sprachmodell laden" Style="{DynamicResource Diktat.TitleText}"/>
                    <TextBlock Style="{DynamicResource Diktat.BodyText}"
                               Text="Das Sprachmodell erkennt deine Sprache direkt auf diesem PC. Es wird einmalig geladen, danach geht es ohne Internet."/>
                    <Border Style="{DynamicResource Diktat.Card}">
                        <v:Stack Spacing="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ModelName" FontWeight="SemiBold" FontSize="14.5"/>
                                <TextBlock x:Name="ModelSize" Foreground="{DynamicResource Diktat.TextTertiary}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <TextBlock x:Name="ModelDetail" Style="{DynamicResource Diktat.CaptionText}"/>
                            <StackPanel x:Name="ModelProgressPanel" Visibility="Collapsed">
                                <ProgressBar x:Name="ModelProgress" AutomationProperties.Name="Sprachmodell wird geladen"/>
                                <TextBlock x:Name="ModelProgressText" Style="{DynamicResource Diktat.CaptionText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="ModelError" Style="{DynamicResource Diktat.ErrorText}" Visibility="Collapsed"/>
                            <StackPanel x:Name="ModelInstalled" Orientation="Horizontal" Visibility="Collapsed">
                                <TextBlock Style="{DynamicResource Diktat.IconText}" Text="&#xE73E;" Foreground="{DynamicResource Diktat.SuccessText}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ModelInstalledText" Style="{DynamicResource Diktat.SuccessText}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ModelDownloadButton" Style="{DynamicResource Diktat.PrimaryButton}" Click="OnDownloadModel" Margin="0,0,8,0"/>
                                <Button x:Name="ModelCancelButton" Content="Abbrechen" Click="OnCancelModel" Visibility="Collapsed"/>
                            </StackPanel>
                        </v:Stack>
                    </Border>
                    <TextBlock Style="{DynamicResource Diktat.SmallText}"
                               Text="Andere Modelle wie Whisper für rund 100 Sprachen findest du später unter Einstellungen, Modelle."/>
                </v:Stack>

                <!-- 4 Kurzbefehl -->
                <v:Stack x:Name="TryStep" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="Kurzbefehl ausprobieren" Style="{DynamicResource Diktat.TitleText}"/>
                    <TextBlock x:Name="TryTitle" Style="{DynamicResource Diktat.HeadingText}"/>
                    <TextBlock Style="{DynamicResource Diktat.BodyText}"
                               Text="Klick in das Feld unten, halte das Kürzel, sag einen Satz und lass los. Der Text landet dort, wo dein Cursor steht, in jeder App."/>
                    <TextBox x:Name="TryBox" Style="{DynamicResource Diktat.MultilineTextBox}" Height="110" v:Hint.Text="Hier hinein diktieren …"
                             AutomationProperties.Name="Probefeld zum Diktieren"/>
                    <Border x:Name="TryStatus" Style="{DynamicResource Diktat.Notice}" Visibility="Collapsed">
                        <TextBlock x:Name="TryStatusText" TextWrapping="Wrap"/>
                    </Border>
                    <Border x:Name="TrySuccess" Style="{DynamicResource Diktat.SuccessNotice}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource Diktat.IconText}" Text="&#xE73E;" Foreground="{DynamicResource Diktat.SuccessText}" Margin="0,0,8,0"/>
                            <TextBlock Text="Geklappt! So geht es überall." FontWeight="SemiBold" Foreground="{DynamicResource Diktat.SuccessText}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="TryModelMissing" Style="{DynamicResource Diktat.ErrorText}" Visibility="Collapsed"
                               Text="Ohne Sprachmodell kann Diktat nicht transkribieren. Geh einen Schritt zurück und lade das Modell."/>
                    <TextBlock Style="{DynamicResource Diktat.SmallText}"
                               Text="Das Kürzel kannst du später unter Einstellungen, Allgemein ändern, auch auf „Umschalten“: einmal drücken zum Starten, nochmal zum Beenden."/>
                </v:Stack>

                <!-- 5 KI-Anbieter -->
                <v:Stack x:Name="AIStep" Spacing="16" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="KI-Anbieter" Style="{DynamicResource Diktat.TitleText}"/>
                        <Border Style="{DynamicResource Diktat.BetaBadge}" Margin="10,4,0,0" ToolTip="{x:Null}">
                            <TextBlock Text="Optional" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Diktat.Accent}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{DynamicResource Diktat.BodyText}"
                               Text="Wortgenaues Diktieren läuft ohne. KI-Schreibstil, WTF und :-) brauchen ein Sprachmodell: deinen eigenen API-Key oder Ollama bzw. LM Studio auf diesem PC. Das geht auch später unter Einstellungen, KI-Anbieter."/>
                    <ContentControl x:Name="AIHost" Focusable="False"/>
                </v:Stack>

                <!-- 6 Fertig -->
                <v:Stack x:Name="DoneStep" Spacing="16" Visibility="Collapsed">
                    <TextBlock Text="Fertig" Style="{DynamicResource Diktat.TitleText}" FontSize="30"/>
                    <TextBlock Style="{DynamicResource Diktat.BodyText}"
                               Text="Diktat wartet unsichtbar im Infobereich der Taskleiste. Ein Klick auf das Symbol zeigt die Modi, den letzten Text und den Verlauf."/>
                    <Border Style="{DynamicResource Diktat.Card}">
                        <ItemsControl x:Name="DoneModes" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <c:ModeIcon Mode="{Binding Mode}" Size="32"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource Diktat.TextSecondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <c:HotkeyBadge Grid.Column="2" Label="{Binding Hotkey}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Style="{DynamicResource Diktat.SmallText}" Text="Verlauf, Modi, Meetings und Einstellungen findest du im Diktat-Fenster."/>
                </v:Stack>
            </Grid>
        </ScrollViewer>

        <!-- Navigation -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Diktat.Stroke}" BorderThickness="0,1,0,0" Padding="28,12" Background="{DynamicResource Diktat.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="LaterButton" Content="Später" Style="{DynamicResource Diktat.SubtleButton}" Click="OnLater"
                        Foreground="{DynamicResource Diktat.TextSecondary}" ToolTip="Den Assistenten schließen. Er bleibt im Infobereich erreichbar."/>
                <Button x:Name="BackButton" Grid.Column="2" Content="Zurück" Click="OnBack" Margin="0,0,8,0"/>
                <Button x:Name="NextButton" Grid.Column="3" Content="Weiter" Style="{DynamicResource Diktat.PrimaryButton}" Click="OnNext" MinWidth="120"/>
            </Grid>
        </Border>
    </Grid>
</Window>
